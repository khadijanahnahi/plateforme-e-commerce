POSTGRES_DB=ecommerce_db
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=change-me-postgres-password

SERVER_PORT=8080
SHOPSPHERE_PROXY_UPSTREAM_PORT=8088
MINIO_BACKUP_PORT=9000

JWT_SECRET=change-this-jwt-secret-minimum-64-characters-before-production
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_REFRESH_COOKIE_SECURE=false
APP_REFRESH_COOKIE_SAME_SITE=Lax

APP_ADMIN_ENABLED=true
APP_ADMIN_FULL_NAME=ShopSphere Admin
APP_ADMIN_EMAIL=admin@shopsphere.local
APP_ADMIN_PHONE=+212600000000
APP_ADMIN_PASSWORD=change-me-admin-password

APP_AUTH_RATE_LIMIT_ENABLED=true
APP_AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
APP_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

APP_EMAIL_ENABLED=false
APP_EMAIL_FROM=no-reply@shopsphere.local
APP_EMAIL_STORE_NAME=ShopSphere
FRONTEND_URL=http://localhost:5173
AWS_SES_SMTP_HOST=
AWS_SES_SMTP_PORT=587
AWS_SES_SMTP_USERNAME=
AWS_SES_SMTP_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=shopsphere/products

APP_INVOICE_STORAGE_PROVIDER=minio
APP_INVOICE_STORAGE_PATH=/app/storage/invoices
MINIO_ROOT_USER=shopsphere_minio
MINIO_ROOT_PASSWORD=change-me-minio-root-password
MINIO_BUCKET=shopsphere-invoices
MINIO_INVOICE_PREFIX=invoices
APP_BLOG_STORAGE_PROVIDER=minio
MINIO_BLOG_BUCKET=shopsphere-media
APP_BLOG_MAX_IMAGE_SIZE=5242880
