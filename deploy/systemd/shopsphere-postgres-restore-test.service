[Unit]
Description=Validate the latest ShopSphere PostgreSQL backup
Documentation=file:/opt/shopsphere/current/docs/backups.md
Requires=docker.service
After=docker.service
ConditionPathExists=/etc/shopsphere/backup.env

[Service]
Type=oneshot
User=root
Group=root
Environment=BACKUP_ENV_FILE=/etc/shopsphere/backup.env
ExecStart=/opt/shopsphere/current/scripts/restore-postgres-test.sh --latest --drop-after
UMask=0077
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/shopsphere/backups /var/log/shopsphere-backups /var/lib/shopsphere-backups /run/lock/shopsphere-backups /run
TimeoutStartSec=4h

[Install]
WantedBy=multi-user.target
