# Install the real file as /etc/shopsphere/backup.env with:
#   sudo chown root:root /etc/shopsphere/backup.env
#   sudo chmod 600 /etc/shopsphere/backup.env

# Docker Compose project
SHOPSPHERE_ROOT=/opt/shopsphere/current
COMPOSE_FILE=/opt/shopsphere/current/docker-compose.yml
COMPOSE_ENV_FILE=/opt/shopsphere/current/.env.production
POSTGRES_SERVICE=postgres

# PostgreSQL identifiers only. The password remains in COMPOSE_ENV_FILE and in
# the postgres container environment; backup scripts never put it in argv.
POSTGRES_DB=ecommerce_db
POSTGRES_USER=ecommerce_user
POSTGRES_BACKUP_DIR=/opt/shopsphere/backups/postgres
POSTGRES_LOCAL_RETENTION_DAYS=14
POSTGRES_MIN_FREE_MB=2048
POSTGRES_REMOTE_ENABLED=true
POSTGRES_REMOTE_PREFIX=postgres
POSTGRES_REMOTE_RETENTION_DAYS=90

# Backup runtime, logs, locks and health metrics
BACKUP_LOG_DIR=/var/log/shopsphere-backups
BACKUP_STATE_DIR=/var/lib/shopsphere-backups
BACKUP_LOCK_DIR=/run/lock/shopsphere-backups

# Optional HTTP endpoint receiving a small JSON success/failure notification.
# Leave empty to disable notifications. Credentials may be embedded only in the
# root-only real file, never in this example or in Git.
BACKUP_MONITORING_URL=

# Local MinIO source. Replace placeholders in /etc/shopsphere/backup.env.
MINIO_SOURCE_URL=http://127.0.0.1:9000
MINIO_SOURCE_ACCESS_KEY=replace-with-source-access-key
MINIO_SOURCE_SECRET_KEY=replace-with-source-secret-key
MINIO_SOURCE_ALIAS=shopsphere-source

# Off-VPS S3-compatible destination. This endpoint must not be the source VPS.
MINIO_REMOTE_URL=https://s3.example-backup-provider.com
MINIO_REMOTE_ACCESS_KEY=replace-with-remote-access-key
MINIO_REMOTE_SECRET_KEY=replace-with-remote-secret-key
MINIO_REMOTE_ALIAS=shopsphere-offsite
MINIO_REMOTE_BUCKET=shopsphere-production-backups
MINIO_REMOTE_PREFIX=minio

# Keep this list aligned with the real application buckets. The current
# docker-compose default for invoices is "shopsphere-invoices"; use that name
# here if MINIO_BUCKET was not changed to "invoices".
MINIO_BUCKETS="products categories banners invoices"
MINIO_LOCAL_BACKUP_DIR=/opt/shopsphere/backups/minio
MINIO_LOCAL_RETENTION_DAYS=14
MINIO_REMOTE_RETENTION_DAYS=90
MINIO_MIN_FREE_MB=512

# MinIO Client binary and optional TLS flag for a private CA during bootstrap.
MC_BIN=/usr/local/bin/mc
MINIO_INSECURE=false
